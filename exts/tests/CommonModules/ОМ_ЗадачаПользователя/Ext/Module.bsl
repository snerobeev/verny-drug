// Модульные тесты YAxUnit для задачи ЗадачаПользователя:
// заполнение даты выполнения в ПередЗаписью.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ВТранзакции()
		.ДобавитьТест("ВыполненнаяЗадачаПолучаетДатуВыполнения", "Выполненная задача получает дату выполнения")
		.ДобавитьТест("ДатаВыполненияНеПерезаписывается", "Заполненная дата выполнения не перезаписывается")
		.ДобавитьТест("НевыполненнаяЗадачаОчищаетДату", "У невыполненной задачи дата очищается");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ВыполненнаяЗадачаПолучаетДатуВыполнения() Экспорт

	Задача = НоваяЗадача();
	Задача.Выполнена = Истина;
	Задача.Записать();

	ЮТест.ОжидаетЧто(Задача.ДатаВыполнения, "Дата выполнения").Заполнено();

КонецПроцедуры

Процедура ДатаВыполненияНеПерезаписывается() Экспорт

	ДатаВыполнения = '20250101120000';
	Задача = НоваяЗадача();
	Задача.Выполнена = Истина;
	Задача.ДатаВыполнения = ДатаВыполнения;
	Задача.Записать();

	ЮТест.ОжидаетЧто(Задача.ДатаВыполнения, "Дата выполнения").Равно(ДатаВыполнения);

КонецПроцедуры

Процедура НевыполненнаяЗадачаОчищаетДату() Экспорт

	Задача = НоваяЗадача();
	Задача.Выполнена = Ложь;
	Задача.ДатаВыполнения = '20250101120000';
	Задача.Записать();

	ЮТест.ОжидаетЧто(Задача.ДатаВыполнения, "Дата выполнения").НеЗаполнено();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяЗадача()

	Задача = Задачи.ЗадачаПользователя.СоздатьЗадачу();
	Задача.Дата = ТекущаяДатаСеанса();
	Задача.Наименование = "Тестовая задача";
	Возврат Задача;

КонецФункции

#КонецОбласти
