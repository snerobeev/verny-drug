// Модульные тесты YAxUnit для документа ПриходнаяНакладная:
// проведение по регистру накопления ОстаткиНаСкладах.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ВТранзакции()
		.ДобавитьТест("ПроведениеСоздаетДвижениеНаКаждуюСтроку", "Проведение: по движению на каждую строку")
		.ДобавитьТест("ДвижениеЗаполняетсяИзДокумента", "Проведение: реквизиты движения")
		.ДобавитьТест("ОстатокПослеПриходаРавенКоличеству", "Проведение: остаток корма после прихода")
		.ДобавитьТест("ОтменаПроведенияУдаляетДвижения", "Отмена проведения удаляет движения");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ПроведениеСоздаетДвижениеНаКаждуюСтроку() Экспорт

	Склад = НовыйСклад();
	Строки = Новый Массив;
	Строки.Добавить(ОписаниеСтроки(НоваяНоменклатура("Корм сухой"), 10, 50));
	Строки.Добавить(ОписаниеСтроки(НоваяНоменклатура("Корм влажный"), 4, 120));

	Накладная = ПроведеннаяНакладная(Склад, Строки);

	ЮТест.ОжидаетЧто(ДвиженияНакладной(Накладная).Количество(), "Количество движений")
		.Равно(2);

КонецПроцедуры

Процедура ДвижениеЗаполняетсяИзДокумента() Экспорт

	Склад = НовыйСклад();
	Номенклатура = НоваяНоменклатура("Корм сухой");
	Строки = Новый Массив;
	Строки.Добавить(ОписаниеСтроки(Номенклатура, 10, 50));

	Накладная = ПроведеннаяНакладная(Склад, Строки);
	Движения = ДвиженияНакладной(Накладная);

	ЮТест.ОжидаетЧто(Движения.Количество(), "Количество движений").Равно(1);
	Движение = Движения[0];
	ЮТест.ОжидаетЧто(Движение.ВидДвижения, "Вид движения").Равно(ВидДвиженияНакопления.Приход);
	ЮТест.ОжидаетЧто(Движение.Период, "Период").Равно(Накладная.Дата);
	ЮТест.ОжидаетЧто(Движение.Склад, "Склад").Равно(Склад);
	ЮТест.ОжидаетЧто(Движение.Партия, "Партия").Равно(Накладная);
	ЮТест.ОжидаетЧто(Движение.Номенклатура, "Номенклатура").Равно(Номенклатура);
	ЮТест.ОжидаетЧто(Движение.Количество, "Количество").Равно(10);
	ЮТест.ОжидаетЧто(Движение.Сумма, "Сумма").Равно(500);

КонецПроцедуры

Процедура ОстатокПослеПриходаРавенКоличеству() Экспорт

	Склад = НовыйСклад();
	Номенклатура = НоваяНоменклатура("Корм сухой");
	Строки = Новый Массив;
	Строки.Добавить(ОписаниеСтроки(Номенклатура, 10, 50));

	ПроведеннаяНакладная(Склад, Строки);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиНаСкладах.Остатки(
	|			,
	|			Склад = &Склад
	|				И Номенклатура = &Номенклатура) КАК Остатки";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	ЮТест.ОжидаетЧто(Выборка.Количество, "Остаток корма").Равно(10);

КонецПроцедуры

Процедура ОтменаПроведенияУдаляетДвижения() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(ОписаниеСтроки(НоваяНоменклатура("Корм сухой"), 10, 50));
	Накладная = ПроведеннаяНакладная(НовыйСклад(), Строки);

	Объект = Накладная.ПолучитьОбъект();
	Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);

	ЮТест.ОжидаетЧто(ДвиженияНакладной(Накладная).Количество(), "Движений после отмены")
		.Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйСклад()

	Объект = Справочники.Склады.СоздатьЭлемент();
	Объект.Наименование = "Тестовый склад";
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция НоваяНоменклатура(Наименование)

	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ОписаниеСтроки(Номенклатура, Количество, Цена)

	Возврат Новый Структура("Номенклатура, Количество, Цена", Номенклатура, Количество, Цена);

КонецФункции

Функция ПроведеннаяНакладная(Склад, Строки)

	Документ = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Склад = Склад;
	Для Каждого Описание Из Строки Цикл
		Строка = Документ.СписокНоменклатуры.Добавить();
		Строка.Номенклатура = Описание.Номенклатура;
		Строка.Количество = Описание.Количество;
		Строка.ЕдиницаИзмерения = Перечисления.ЕдиницыИзмерения.Кг;
		Строка.Цена = Описание.Цена;
		Строка.Сумма = Описание.Количество * Описание.Цена;
	КонецЦикла;
	Документ.СуммаПоДокументу = Документ.СписокНоменклатуры.Итог("Сумма");
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Документ.Ссылка;

КонецФункции

Функция ДвиженияНакладной(Накладная)

	Набор = РегистрыНакопления.ОстаткиНаСкладах.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Накладная);
	Набор.Прочитать();
	Возврат Набор;

КонецФункции

#КонецОбласти
