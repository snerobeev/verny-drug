
&НаКлиенте
Процедура ПутьКФотоНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Описание = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(Описание, , , , , УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(Результат, Параметры) Экспорт
	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	// Оставляем как есть — просто ПутьКФото
	ПутьКФото = Результат.Адрес;
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// Магия сохранения: из переменной формы в реквизит объекта Фото
	Если ЭтоАдресВременногоХранилища(ПутьКФото) Тогда
		ТекущийОбъект.Фото = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(ПутьКФото));
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// Вытаскиваем ссылку из базы в переменную формы
	ПутьКФото = ПолучитьНавигационнуюСсылку(Объект.Ссылка, "Фото");
	// Вызываем наш диспетчер, чтобы обновить норму питания при открытии карточки
	РассчитатьНормуНаСервере();
	
КонецПроцедуры

//Изменение породы в зависимости от вида
&НаКлиенте
Процедура ПородыЖивотныхПриИзменении(Элемент)
	Если Объект.ПородыЖивотных.Пустая() Тогда
		Возврат;
	КонецЕсли;
	Объект.ВидЖивотного = ПолучитьВидИзПороды(Объект.ПородыЖивотных);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВидИзПороды(Знач СсылкаНаПороду)
	Возврат СсылкаНаПороду.ВидЖивотного;
КонецФункции

//Расчет порции от веса животного
&НаСервереБезКонтекста
Функция ВесПриИзмененииНаСервере(ВидЖивотного,Вес)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НормыКормления.КоличествоКорма КАК КоличествоКорма
	|ИЗ
	|	РегистрСведений.НормыКормления КАК НормыКормления
	|ГДЕ
	|	НормыКормления.ВидЖивотного = &ВидЖивотного
	|	И НормыКормления.ВесОт <= &ВесОт
	|	И НормыКормления.ВесДо >= &ВесДо";
	
	Запрос.УстановитьПараметр("ВесДо", Вес);
	Запрос.УстановитьПараметр("ВесОт", Вес);
	Запрос.УстановитьПараметр("ВидЖивотного", ВидЖивотного);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.КоличествоКорма;
	КонецЦикла;
	Возврат 0;
КонецФункции

&НаКлиенте
Процедура ВесПриИзменении(Элемент)
	
	// 1. Сначала вызываем общую магию пересчета
	РассчитатьНормуНаСервере(); 
	
	// 2. А потом проверяем — если после расчета в поле остался 0, ругаемся
	Если Объект.СуточнаяНорма = 0 И Объект.Вес > 0 Тогда
		Сообщить("Внимание! Нормы не найдены.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНормуНаСервере()
	// Здесь мы просто вызываем твою готовую функцию
	Объект.СуточнаяНорма = ВесПриИзмененииНаСервере(Объект.ВидЖивотного, Объект.Вес);
КонецПроцедуры 


&НаКлиенте
Процедура ВидЖивотногоПриИзменении(Элемент)
	РассчитатьНормуНаСервере()
КонецПроцедуры

