
// GET /hs/shelter/animals/{code}
// 200 и карточка питомца в JSON; 404, если питомца с таким кодом нет.
Функция ПитомецGET(Запрос)
	
	Код = Запрос.ПараметрыURL["code"];
	Питомец = Справочники.Питомцы.НайтиПоКоду(Код);
	
	Если Питомец.Пустая() Тогда
		Возврат ОтветJSON(404, Новый Структура("error", "Питомец с кодом " + Код + " не найден"));
	КонецЕсли;
	
	Возврат ОтветJSON(200, КарточкаПитомца(Питомец));
	
КонецФункции

// Карточка питомца для внешних сервисов.
// Личные и служебные данные (чип, паспорт, бывший владелец) сознательно не включаются.
Функция КарточкаПитомца(Питомец)
	
	Карточка = Новый Структура;
	Карточка.Вставить("code",        СокрЛП(Питомец.Код));
	Карточка.Вставить("name",        Питомец.Наименование);
	Карточка.Вставить("species",     ПредставлениеИлиNull(Питомец.ВидЖивотного));
	Карточка.Вставить("breed",       ПредставлениеИлиNull(Питомец.ПородыЖивотных));
	Карточка.Вставить("sex",         ПредставлениеИлиNull(Питомец.ПолЖивотного));
	Карточка.Вставить("birthDate",   ДатаИлиNull(Питомец.ДатаРождения));
	Карточка.Вставить("color",       ПредставлениеИлиNull(Питомец.Цвет));
	Карточка.Вставить("status",      ПредставлениеИлиNull(Питомец.Статус));
	Карточка.Вставить("shelter",     ПредставлениеИлиNull(Питомец.Приют));
	Карточка.Вставить("arrivalDate", ДатаИлиNull(Питомец.ДатаПоступления));
	
	Возврат Карточка;
	
КонецФункции

Функция ПредставлениеИлиNull(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Строка(Значение);
	
КонецФункции

Функция ДатаИлиNull(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Формат(Дата, "ДФ=yyyy-MM-dd");
	
КонецФункции

Функция ОтветJSON(КодСостояния, Данные)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
	
КонецФункции